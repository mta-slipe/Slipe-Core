<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<RootNamespace>SlipeLua.MtaDefinitions</RootNamespace>
		<AssemblyName>SlipeLua.MtaDefinitions</AssemblyName>

		<Version>0.1.10</Version>
		<Authors>Slipe</Authors>
		<Company></Company>
		<Product>Slipe Lua MTA Definitions</Product>
		<PackageProjectUrl>https://github.com/mta-slipe/Slipe-core</PackageProjectUrl>
		<PackageIcon>slipe-logo.png</PackageIcon>
		<RepositoryUrl>https://github.com/mta-slipe/Slipe-core</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<Description>Slipe Lua MTA function definitions</Description>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
	</ItemGroup>

	<ItemGroup>
		<None Include="Lua\**\*" Pack="true" PackagePath="contentFiles\any\any\Lua"/>
		<EmbeddedResource Include="Lua\**\*" CopyToOutputDirectory="Always" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\..\..\..\LICENSE">
			<Pack>True</Pack>
			<PackagePath></PackagePath>
		</None>
		<None Include="..\..\..\..\..\slipe-logo.png">
			<Pack>True</Pack>
			<PackagePath></PackagePath>
		</None>
	</ItemGroup>

	<!--<ItemGroup>
	  <ProjectReference Include="..\..\..\..\..\SlipeLua.CSharpLua\SlipeLua.CSharpLua.csproj" />
	</ItemGroup>-->
</Project>
