<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Library</OutputType>
		<TargetFramework>netstandard2.0</TargetFramework>
		<RootNamespace>SlipeLua.Shared</RootNamespace>
		<AssemblyName>SlipeLua.Shared</AssemblyName>
		<RunPostBuildEvent>OnOutputUpdated</RunPostBuildEvent>

		<Version>0.1.11</Version>
		<Authors>Slipe</Authors>
		<Company></Company>
		<Product>Slipe Lua Shared</Product>
		<PackageProjectUrl>https://github.com/mta-slipe/Slipe-core</PackageProjectUrl>
		<PackageIcon>slipe-logo.png</PackageIcon>
		<RepositoryUrl>https://github.com/mta-slipe/Slipe-core</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<Description>Slipe Lua Shared class lib</Description>

		<LangVersion>Latest</LangVersion>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="System.Numerics.Vectors" Version="4.6.1" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\..\..\..\CodeGenerator\SlipeLua.CodeGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
		<ProjectReference Include="..\SlipeMTADefinitions\SlipeMTADefinitions.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Include="Lua\**\*" Pack="true" PackagePath="contentFiles\any\any\Lua"/>
		<EmbeddedResource Include="Lua\**\*" CopyToOutputDirectory="Always" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\..\..\..\LICENSE">
			<Pack>True</Pack>
			<PackagePath></PackagePath>
		</None>
		<None Include="..\..\..\..\..\slipe-logo.png">
			<Pack>True</Pack>
			<PackagePath></PackagePath>
		</None>
	</ItemGroup>

</Project>
